{
  "name": "summono",
  "version": "0.2.0",
  "private": true,
  "description": "One click and DeepSeek Harness is running — the launcher and installer for AI harnesses",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liustack/summono.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "node scripts/run.mjs smoke",
    "smoke:dsh": "node scripts/run.mjs smoke:dsh",
    "smoke:apps": "node scripts/run.mjs smoke:apps",
    "dist": "electron-vite build && electron-builder"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
